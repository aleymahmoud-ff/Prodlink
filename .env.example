# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional: For server-side operations that need elevated access
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Factory time zone — used by server-side dashboard aggregations to define
# "today" / "yesterday" consistently across users. Live data-entry pages use
# the user's browser time zone; only the cross-user dashboard uses this.
# IANA name. Default if unset: Africa/Cairo. Egypt does not observe DST.
FACTORY_TIMEZONE=Africa/Cairo
